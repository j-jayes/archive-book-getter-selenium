# Internet Archive Credentials
ARCHIVE_USERNAME=your_username_here
ARCHIVE_PASSWORD=your_password_here

# Chrome Profile Path (Mac default)
# Find your profile path by going to chrome://version/ and looking for "Profile Path"
CHROME_PROFILE_PATH=/Users/YOUR_USERNAME/Library/Application Support/Google/Chrome

# Target Book URL
BOOK_URL=https://archive.org/details/your-book-identifier

# Output settings
OUTPUT_FILE=extracted_text.txt
